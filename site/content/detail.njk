---
pagination:
  data: library.all
  size: 1
  alias: item
permalink: "{{ item.url }}"
eleventyComputed:
  title: "{{ item.title }}"
  detailKind: "{{ item.kind }}"
  bodyClass: "{% if item.kind == 'talk' %}page-talk{% else %}page-project-detail{% endif %}"
layout: base.njk
---
{% if item.kind == 'talk' %}
<header class="hero"><div class="container"><div class="breadcrumb"><a href="index.html">首页</a> / <a href="talks.html">专家分享</a> / {{ item.speaker }}</div><div class="hero-grid"><div><h1>{{ item.title }}</h1>{% if item.englishTitle %}<p class="english-title" lang="en">{{ item.englishTitle }}</p>{% endif %}{% if item.awards %}<div class="awards">{% for award in item.awards | lines %}<p>{{ award }}</p>{% endfor %}</div>{% endif %}{% if item.secondaryTitle %}<p class="secondary-title">{{ item.secondaryTitle }}</p>{% endif %}</div><aside class="event-info"><h2>专家学术分享</h2><dl><div><dt>分享嘉宾</dt><dd>{{ item.speaker }}</dd></div>{% if item.eventDate %}<div><dt>活动时间</dt><dd><time datetime="{{ item.eventDate }}T{{ item.eventStart }}:00+08:00">{{ item.eventDate }} {{ item.eventStart }}–{{ item.eventEnd }}</time><br>北京时间（UTC+8）</dd></div>{% endif %}<div><dt>主办社区</dt><dd>Moss具身工坊</dd></div></dl><a class="button" href="index.html#join">加入社群了解参会方式 ↗</a></aside></div></div></header>
{% if item.image %}<div class="container"><figure class="talk-figure"><img data-transition-image src="{{ item.image }}" alt="{{ item.imageAlt or item.title }}" loading="eager"><figcaption>{{ item.imageAlt }}{% if item.imageCreditUrl %} · 图片来源：<a href="{{ item.imageCreditUrl }}">{{ item.imageCredit }}</a>{% endif %}</figcaption></figure></div>{% endif %}
<section class="speaker"><div class="container speaker-grid"><div><h2 id="speaker-title">{{ item.speaker }}</h2><p class="speaker-role">{% for line in item.speakerRole | lines %}{{ line }}<br>{% endfor %}</p></div><div class="speaker-copy">{{ item.bio | markdown | safe }}</div></div></section><div class="reading"><div class="container reading-grid"><article class="article"><section>{{ item.body | markdown('talk') | safe }}</section></article>{% if item.agenda or item.sourceLinks %}<aside>{% if item.agenda %}<section class="agenda" id="agenda"><h2 id="agenda-title">分享大纲</h2>{{ item.agenda | markdown | safe }}</section>{% endif %}{% if item.sourceLinks %}<section class="project-links" aria-labelledby="links-title"><h2 id="links-title">相关项目</h2>{% for source in item.sourceLinks %}<a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.label }} ↗</a>{% endfor %}</section>{% endif %}</aside>{% endif %}</div></div>
{% else %}
<section class="page-hero"><div class="container"><div class="breadcrumb"><a href="index.html">首页</a> / <a href="{% if item.kind == 'project' %}projects{% elif item.kind == 'knowledge' %}knowledge{% else %}updates{% endif %}.html">{% if item.kind == 'project' %}共创项目{% elif item.kind == 'knowledge' %}知识分享{% else %}社区动态{% endif %}</a> / 正文</div><h1>{{ item.title }}</h1><p class="lead">{{ item.summary }}</p></div></section>
<section class="project-detail"><div class="container"><div class="detail-grid"><aside class="visual">{% if item.image %}<figure><img data-transition-image src="{{ item.image }}" alt="{{ item.imageAlt or item.title }}"><figcaption>{{ item.imageAlt or item.title }}</figcaption></figure>{% endif %}{% if item.headings.length %}<nav class="project-index" aria-label="本文目录">{% for heading in item.headings %}<a href="#{{ heading.id }}">{{ heading.title }}</a>{% endfor %}</nav>{% endif %}</aside><div class="content">{% if item.metrics %}<div class="metrics">{% for metric in item.metrics %}<div class="metric"><div class="value">{{ metric.value }}</div><div class="label">{{ metric.label }}</div></div>{% endfor %}</div>{% endif %}{{ item.body | markdown(item.kind) | safe }}{% if item.detailTags %}<div class="tech-tags">{% for tag in item.detailTags %}<span>{{ tag }}</span>{% endfor %}</div>{% endif %}{% if item.externalUrl %}<p><a href="{{ item.externalUrl }}">查看相关资料 ↗</a></p>{% endif %}{% if item.relatedUrl %}<p><a href="{{ item.relatedUrl }}">查看相关内容 ↗</a></p>{% endif %}</div></div></div></section>
{% endif %}
<section class="join-hero"><div class="container"><div class="join-card"><div class="join-info"><h3>一起参与</h3>{% if item.kind == 'talk' %}<p>微信扫码加入社区，与伙伴交流、分享与共创。</p>{% else %}<p>{{ item.joinText or "加入社区，与伙伴交流、分享与共创。" }}</p><a href="index.html#join" class="join-btn">查看社群加入方式 ↗</a>{% endif %}</div>{% if item.kind == 'talk' %}<figure class="join-qr"><div class="join-qr-frame{% if library.site.qrImage == 'assets/media/moss-wechat-qr.png' %} is-original-screenshot{% endif %}"><img src="{{ library.site.qrImage }}" alt="Moss具身工坊微信群二维码" width="360" height="544" loading="lazy"></div><figcaption>{{ library.site.qrExpiry }}</figcaption></figure>{% endif %}</div></div></section>
